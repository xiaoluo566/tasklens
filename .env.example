# Copy to .env — auto-loaded. Only needed for remote browsers.
BROWSER_USE_API_KEY=bu_your_key_here

# Optional TaskLens model provider. Leave unset for the safe runtime-unavailable
# response, or use TASKLENS_MODEL_PROVIDER=demo for a zero-network smoke run.
TASKLENS_MODEL_PROVIDER=openai
TASKLENS_LLM_BASE_URL=https://api.example.com/v1
TASKLENS_LLM_API_KEY=
TASKLENS_LLM_MODEL=
TASKLENS_LLM_TIMEOUT_SECONDS=60
